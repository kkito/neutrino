# agent 上线配置。隧道以 server 的 desired.toml 为准，此处 proxies 仅兼容保留（有值会被忽略）。
# server 可空：CLI --server 兜底；WebUI 修改后回写此文件。
hostname = "minipc7s"
token = "welcome2neutrino"
server = "ws://127.0.0.1:7440/ws"

# 启动本地 WebUI（可选）：
# neutrino agent --server ws://127.0.0.1:7440/ws --config agent.toml \
#   --web 127.0.0.1:8080 --web-user admin --web-pass neutrino123
